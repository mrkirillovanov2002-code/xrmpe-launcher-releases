<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="Xrmpe.Launcher.Views.ZoneBackdrop" IsHitTestVisible="False">
  <Grid Background="#0B0F14"><Image Name="SceneImage" Stretch="UniformToFill" /><Border><Border.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="0%,100%"><GradientStop Color="#0A0B0F14" Offset="0" /><GradientStop Color="#CC0B0F14" Offset="1" /></LinearGradientBrush></Border.Background></Border></Grid>
</UserControl>
